# Supabase — proje ayarlarından al (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# Server-side insert için service role (gizli! sadece sunucuda)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
# Veri yükleme (/api/upload) koruması — ekip üyeleri bu anahtarı yükleme sayfasına girer.
# Rastgele üret: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
UPLOAD_TOKEN=uzun-rastgele-gizli-anahtar
# Siteye giriş için 6 haneli PIN (middleware kapısı)
SITE_PIN=000000
# Oturum çerezi imzası — rastgele üret:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CORTEX_SESSION=uzun-rastgele-oturum-anahtari
